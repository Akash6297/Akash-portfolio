# ── Site ──────────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://akash-mandal.vercel.app

# ── Contact form (required for the form to send) ──────────────────────
# Gmail address that sends the notification, plus a Gmail *App Password*
# (Google Account → Security → 2-Step Verification → App passwords).
EMAIL_USER=
EMAIL_PASS=
# Optional SMTP overrides (defaults to Gmail over SSL).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
# Optional: where messages are delivered. Defaults to EMAIL_USER.
CONTACT_TO_EMAIL=

# ── GitHub activity (optional) ────────────────────────────────────────
# Without a token the public API allows 60 requests/hour, which is plenty
# because responses are cached for an hour. A fine-grained token with no
# scopes raises the limit. Server-only — never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=
