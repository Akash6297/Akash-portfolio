# Copy to .env.local (development) and set the same variables in Vercel.

# ── Site ──────────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://akash-mandal.vercel.app

# ── Database & admin panel (/admin) ───────────────────────────────────
# Your existing MongoDB. Admin accounts, messages, bookings, email templates
# and resume data from the previous site carry over. Without it, the public
# site still works using the built-in content, but /admin is unavailable.
MONGO_URI=
# Long random string used to sign admin sessions (keep your existing value).
SESSION_SECRET=
# The admin account with this email is the super admin (can manage admins).
SUPER_ADMIN_EMAIL=
# Image uploads from the admin panel (https://api.imgbb.com/). Optional:
# without it you can still paste image URLs.
IMGBB_API_KEY=

# ── Email (contact form, replies, bookings, admin verification codes) ─
# Gmail address that sends mail, plus a Gmail *App Password*
# (Google Account → Security → 2-Step Verification → App passwords).
EMAIL_USER=
EMAIL_PASS=
# Optional SMTP overrides (defaults to Gmail over SSL).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
# Optional: where notifications are delivered. Defaults to EMAIL_USER.
CONTACT_TO_EMAIL=

# ── GitHub activity (optional) ────────────────────────────────────────
# Raises the GitHub API rate limit. Server-only — never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=
